{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/product/**",
              "ui_kits/apps/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto))/i]",
        "message": "Font not provided by the design system. Available: Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplicationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:institution|status|tone|meta|onDark|style|key|ref|className|style|children)$/]",
        "message": "<ApplicationRow> doesn't accept that prop. Declared props: institution, status, tone, meta, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplicationRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accepted|review|submitted|draft|due|uniapply|pathfinder)$/]",
        "message": "<ApplicationRow> tone must be one of 'accepted' | 'review' | 'submitted' | 'draft' | 'due' | 'uniapply' | 'pathfinder'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|shape|arrow|block|elevated|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, shape, arrow, block, elevated, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pathfinder|uniapply|futureclub|secondary|ghost|onDark)$/]",
        "message": "<Button> variant must be one of 'pathfinder' | 'uniapply' | 'futureclub' | 'secondary' | 'ghost' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill|rounded)$/]",
        "message": "<Button> shape must be one of 'square' | 'pill' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|accent|pad|rounded|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, accent, pad, rounded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:white|cream|navy|blue|yellow|orange|stone|glass)$/]",
        "message": "<Card> surface must be one of 'white' | 'cream' | 'navy' | 'blue' | 'yellow' | 'orange' | 'stone' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeadlineRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|institutions|status|style|key|ref|className|style|children)$/]",
        "message": "<DeadlineRow> doesn't accept that prop. Declared props: date, institutions, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoDontList'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|label|items|style|key|ref|className|style|children)$/]",
        "message": "<DoDontList> doesn't accept that prop. Declared props: mode, label, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoDontList'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:do|dont)$/]",
        "message": "<DoDontList> mode must be one of 'do' | 'dont'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|filled|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lockup|height|width|assetPath|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: lockup, height, width, assetPath, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:bridgeapp|gradesmatch|pathfinder|uniapply)$/]",
        "message": "<Logo> lockup must be one of 'bridgeapp' | 'gradesmatch' | 'pathfinder' | 'uniapply'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathwayProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|accent|onDark|style|key|ref|className|style|children)$/]",
        "message": "<PathwayProgress> doesn't accept that prop. Declared props: steps, current, accent, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhraseChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<PhraseChip> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhraseChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|yellow|orange|navy)$/]",
        "message": "<PhraseChip> tone must be one of 'blue' | 'yellow' | 'orange' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|right|style|key|ref|className|style|children)$/]",
        "message": "<RuleBanner> doesn't accept that prop. Declared props: children, accent, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|eyebrowColor|title|lede|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, eyebrowColor, title, lede, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|accent|onDark|size|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, note, accent, onDark, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatBlock> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|soft|shape|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, soft, shape, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pathfinder|uniapply|futureclub|accepted|review|submitted|draft|due|navy)$/]",
        "message": "<Tag> tone must be one of 'pathfinder' | 'uniapply' | 'futureclub' | 'accepted' | 'review' | 'submitted' | 'draft' | 'due' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|rounded|pill)$/]",
        "message": "<Tag> shape must be one of 'square' | 'rounded' | 'pill'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
